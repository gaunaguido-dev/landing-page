{
  "compilerOptions": {
    "target":            "ES2020",
    "module":            "commonjs",
    "lib":               ["ES2020"],
    "types":             ["node"],
    "moduleResolution":  "node",
    "strict":            true,
    "esModuleInterop":   true,
    "skipLibCheck":      true,
    "declaration":       true,
    "inlineSourceMap":   true,
    "inlineSources":     true,
    "outDir":            "cdk.out/js"
  },
  "include":  ["bin/**/*.ts", "lib/**/*.ts"],
  "exclude":  ["lambdas/**", "node_modules", "cdk.out"]
}

# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is intentionally git-ignored.

project_name = "g2techwork"
environment  = "prod"
aws_region   = "us-east-1"

# Custom domain — leave empty to use the auto CloudFront domain
domain_name    = ""          # e.g. "g2techwork.com"
hosted_zone_id = ""          # Route 53 zone ID — only needed if managing DNS via Terraform

# Email
resend_api_key = "re_xxxxxxxxxxxxxxxxxxxx"   # https://resend.com/api-keys
from_email     = "hola@g2techwork.com"
to_email       = "hola@g2techwork.com"

# Lambda tuning (optional — defaults are fine)
# lambda_memory_mb          = 256
# lambda_timeout_s          = 15
# lambda_log_retention_days = 14

# AWS credentials (or use a named profile via AWS_PROFILE)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_PROFILE=default
AWS_REGION=us-east-1

# Injected into the Astro build by deploy-site.sh — do NOT set manually here.
# The value is read from `terraform output api_endpoint` at deploy time.
# PUBLIC_API_URL=https://xxxx.execute-api.us-east-1.amazonaws.com/contact

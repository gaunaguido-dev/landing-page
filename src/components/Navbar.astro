---
const links = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#proceso',   label: 'Proceso'   },
  { href: '#nosotros',  label: 'Nosotros'  },
];
---

<header class="navbar" id="navbar" role="banner">
  <div class="container nav-inner">
    <a href="/" class="logo" aria-label="g2techwork — inicio">
      <span class="logo-g2">g2</span><span class="logo-rest">techwork</span>
    </a>

    <nav aria-label="Navegación principal">
      <ul class="nav-links" id="nav-links">
        {links.map(l => (
          <li><a href={l.href} class="nav-link">{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href="#contacto" class="btn btn-primary btn-sm">Hablemos</a>
    </div>

    <button
      class="hamburger"
      id="hamburger"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Mobile overlay menu -->
<div class="mobile-menu" id="mobile-menu" role="dialog" aria-label="Menú de navegación" aria-hidden="true">
  <nav>
    <ul>
      {links.map(l => (
        <li><a href={l.href} class="mob-link">{l.label}</a></li>
      ))}
      <li><a href="#contacto" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:0.5rem;">Hablemos</a></li>
    </ul>
  </nav>
</div>

<script>
  const navbar   = document.getElementById('navbar')!;
  const hamburger = document.getElementById('hamburger')!;
  const mobileMenu = document.getElementById('mobile-menu')!;

  // Scroll: add solid background after 60px
  window.addEventListener('scroll', () => {
    navbar.classList.toggle('scrolled', window.scrollY > 60);
  }, { passive: true });

  // Toggle mobile menu
  function toggleMenu(open: boolean) {
    hamburger.setAttribute('aria-expanded', String(open));
    hamburger.classList.toggle('is-open', open);
    mobileMenu.classList.toggle('is-open', open);
    mobileMenu.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('no-scroll', open);
  }

  hamburger.addEventListener('click', () => {
    const isOpen = hamburger.getAttribute('aria-expanded') === 'true';
    toggleMenu(!isOpen);
  });

  // Close on any link click inside mobile menu
  mobileMenu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => toggleMenu(false));
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') toggleMenu(false);
  });
</script>

<style>
  .navbar {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 900;
    padding-block: 1.25rem;
    transition: background 0.35s ease, padding 0.35s ease, box-shadow 0.35s ease;
  }
  .navbar.scrolled {
    background: rgba(11, 31, 58, 0.96);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding-block: 0.875rem;
    box-shadow: 0 1px 0 rgba(255,255,255,0.06), 0 8px 24px rgba(0,0,0,0.28);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  /* Logo */
  .logo {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    margin-right: auto;
    flex-shrink: 0;
  }
  .logo-g2   { color: var(--color-accent); }
  .logo-rest { color: #fff; }

  /* Desktop nav links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }
  .nav-link {
    color: rgba(255,255,255,0.75);
    font-family: var(--font-heading);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-sm);
    transition: color 0.15s, background 0.15s;
  }
  .nav-link:hover {
    color: #fff;
    background: rgba(255,255,255,0.08);
  }

  .nav-actions { flex-shrink: 0; }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 9px 8px;
    border-radius: var(--radius-sm);
    transition: background 0.15s;
    flex-shrink: 0;
  }
  .hamburger:hover { background: rgba(255,255,255,0.1); }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, width 0.3s ease;
    transform-origin: center;
  }
  .hamburger.is-open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .hamburger.is-open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  /* Mobile overlay */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 800;
    background: var(--color-primary-deep);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.4, 0, 0.2, 1);
    padding: 2rem;
  }
  .mobile-menu.is-open { transform: translateX(0); }

  .mobile-menu ul {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.25rem;
    width: 100%;
    max-width: 320px;
  }
  .mob-link {
    display: block;
    padding: 1rem 1.5rem;
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 700;
    color: #fff;
    text-align: center;
    border-radius: var(--radius-md);
    transition: background 0.15s;
  }
  .mob-link:hover { background: rgba(255,255,255,0.08); }

  :global(body.no-scroll) { overflow: hidden; }

  @media (max-width: 768px) {
    .nav-links, .nav-actions { display: none; }
    .hamburger { display: flex; }
  }
</style>

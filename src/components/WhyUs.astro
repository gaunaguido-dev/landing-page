---
const features = [
  {
    icon: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 4L6 18h10l-2 10 12-14H16l2-10z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    title: 'Entrega en tiempo récord',
    description: 'Procesos ágiles y sin fricción que nos permiten entregar en semanas, no en meses. Cada sprint tiene un objetivo claro.',
    stat: '90 días',
    statLabel: 'promedio de lanzamiento',
  },
  {
    icon: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="16" cy="10" r="5" stroke="currentColor" stroke-width="1.75"/><path d="M5 27c0-5 4.5-8 11-8s11 3 11 8" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/><path d="M24 5l2 2-2 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    title: 'Ingenieros senior',
    description: 'Todo el trabajo es ejecutado por ingenieros con años de experiencia en productos de escala real. Sin juniors en proyectos críticos.',
    stat: '100%',
    statLabel: 'ingenieros senior',
  },
  {
    icon: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="4" y="4" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.75"/><rect x="18" y="4" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.75"/><rect x="4" y="18" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.75"/><rect x="18" y="18" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1.75"/></svg>`,
    title: 'Arquitectura escalable',
    description: 'Diseñamos para el crecimiento desde el día uno. Tu producto crece, nosotros lo sostenemos con patrones probados de industria.',
    stat: 'Cloud-first',
    statLabel: 'por diseño',
  },
  {
    icon: `<svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16 3l2.3 7h7.4L19.9 15l2.3 7L16 18l-6.2 4 2.3-7L6.3 10h7.4L16 3z" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>`,
    title: 'Mentalidad de producto',
    description: 'No solo escribimos código. Pensamos en métricas, usuarios y valor de negocio en cada decisión. Somos partners, no contratistas.',
    stat: 'ROI-driven',
    statLabel: 'en cada decisión',
  },
];
---

<section class="whyus" id="nosotros" aria-labelledby="whyus-title">
  <div class="container">
    <div class="whyus-header" data-animate>
      <span class="section-tag light">Por qué elegirnos</span>
      <h2 class="section-title light" id="whyus-title">
        Construido diferente.<br />Entregado rápido.
      </h2>
      <p class="section-subtitle light">
        No somos una agencia tradicional. Somos un equipo de ingenieros con
        mentalidad de producto que trabaja con vos, no para vos.
      </p>
    </div>

    <div class="features-grid">
      {features.map((f, i) => (
        <div class="feature-card" data-animate data-delay={String((i + 1) * 100)}>
          <div class="feature-icon" aria-hidden="true">
            <Fragment set:html={f.icon} />
          </div>
          <div class="feature-body">
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-desc">{f.description}</p>
            <div class="feature-stat">
              <span class="fstat-num">{f.stat}</span>
              <span class="fstat-label">{f.statLabel}</span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Decorative corner glow -->
  <div class="corner-glow" aria-hidden="true"></div>
</section>

<style>
  .whyus {
    position: relative;
    padding-block: var(--section-y);
    background: var(--color-primary);
    overflow: hidden;
  }

  .corner-glow {
    position: absolute;
    bottom: -200px;
    left: -200px;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0,184,196,0.12) 0%, transparent 65%);
    pointer-events: none;
  }

  .whyus-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    position: relative;
    z-index: 1;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .feature-card {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.09);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 3vw, 2rem);
    display: flex;
    gap: 1.25rem;
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.3s var(--ease-out);
  }
  .feature-card:hover {
    background: rgba(255,255,255,0.08);
    border-color: rgba(0,184,196,0.25);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: rgba(0,184,196,0.12);
    border: 1px solid rgba(0,184,196,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: var(--color-accent);
  }
  .feature-icon svg { width: 22px; height: 22px; }

  .feature-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }

  .feature-title {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .feature-desc {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
  }

  .feature-stat {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255,255,255,0.07);
  }
  .fstat-num {
    font-family: var(--font-heading);
    font-size: 1.0625rem;
    font-weight: 800;
    color: var(--color-accent);
    letter-spacing: -0.02em;
  }
  .fstat-label {
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255,255,255,0.35);
    font-family: var(--font-heading);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>

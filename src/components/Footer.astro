---
const year = new Date().getFullYear();

const navLinks = [
  { href: '#servicios', label: 'Servicios'  },
  { href: '#proceso',   label: 'Proceso'    },
  { href: '#nosotros',  label: 'Nosotros'   },
  { href: '#contacto',  label: 'Contacto'   },
];

const services = [
  'Soluciones con IA',
  'Arquitectura Cloud',
  'Desarrollo a Medida',
  'MVP en 90 Días',
];

const social = [
  {
    name: 'LinkedIn',
    href: 'https://linkedin.com/company/g2techwork',
    icon: `<svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M16.667 2H3.333A1.333 1.333 0 002 3.333v13.334A1.333 1.333 0 003.333 18h13.334A1.333 1.333 0 0018 16.667V3.333A1.333 1.333 0 0016.667 2zM6.5 15H4V8.5h2.5V15zM5.25 7.5A1.25 1.25 0 114.001 6.251 1.25 1.25 0 015.25 7.5zM16 15h-2.5v-3.3c0-.787-.016-1.8-1.1-1.8-1.1 0-1.269.858-1.269 1.744V15H8.631V8.5h2.4v.929h.033a2.634 2.634 0 012.37-1.303c2.535 0 3.002 1.669 3.002 3.838V15z"/>`,
  },
  {
    name: 'GitHub',
    href: 'https://github.com/g2techwork',
    icon: `<svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M10 2C5.58 2 2 5.67 2 10.19c0 3.63 2.31 6.71 5.51 7.79.4.08.55-.18.55-.39v-1.37c-2.24.5-2.71-1.1-2.71-1.1-.37-.95-.9-1.2-.9-1.2-.73-.51.06-.5.06-.5.81.06 1.23.84 1.23.84.72 1.24 1.88.88 2.34.67.07-.52.28-.88.51-1.08-1.79-.2-3.67-.91-3.67-4.05 0-.89.31-1.63.83-2.2-.08-.2-.36-1.04.08-2.17 0 0 .67-.22 2.2.83A7.52 7.52 0 0110 7.27c.68 0 1.36.09 2 .27 1.53-1.05 2.2-.83 2.2-.83.44 1.13.16 1.97.08 2.17.52.57.83 1.31.83 2.2 0 3.15-1.88 3.85-3.68 4.05.29.25.54.74.54 1.5v2.22c0 .21.15.47.55.39C15.69 16.9 18 13.82 18 10.19 18 5.67 14.42 2 10 2z"/>`,
  },
  {
    name: 'X / Twitter',
    href: 'https://twitter.com/g2techwork',
    icon: `<svg viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M15.35 3H17.8L12.55 9.07 18.67 17H13.9L10.19 12.15 5.93 17H3.47l5.6-6.44L2.67 3H7.56l3.36 4.45L15.35 3zm-.86 12.6h1.34L6.17 4.37H4.72l9.77 11.23z"/>`,
  },
];
---

<footer class="footer" role="contentinfo">
  <div class="container footer-inner">
    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="g2techwork — inicio">
        <span class="logo-g2">g2</span><span class="logo-rest">techwork</span>
      </a>
      <p class="footer-tagline">
        Software factory especializada en IA, cloud y desarrollo a medida.
        Del concepto al lanzamiento en menos de 90 días.
      </p>
      <div class="footer-location">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1.5C5 1.5 3 3.3 3 5.7c0 3 4 7.3 4 7.3s4-4.3 4-7.3c0-2.4-2-4.2-4-4.2z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <circle cx="7" cy="5.7" r="1.3" fill="currentColor"/>
        </svg>
        Corrientes Capital, Argentina
      </div>
      <div class="footer-social">
        {social.map(s => (
          <a href={s.href} class="social-link" aria-label={s.name} target="_blank" rel="noopener noreferrer">
            <Fragment set:html={s.icon} />
          </a>
        ))}
      </div>
    </div>

    <!-- Nav column -->
    <div class="footer-col">
      <h3 class="footer-col-title">Navegación</h3>
      <ul>
        {navLinks.map(l => (
          <li><a href={l.href} class="footer-link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Services column -->
    <div class="footer-col">
      <h3 class="footer-col-title">Servicios</h3>
      <ul>
        {services.map(s => (
          <li><span class="footer-link">{s}</span></li>
        ))}
      </ul>
    </div>

    <!-- Contact column -->
    <div class="footer-col">
      <h3 class="footer-col-title">Contacto</h3>
      <ul>
        <li>
          <a href="mailto:hola@g2techwork.com" class="footer-link">
            hola@g2techwork.com
          </a>
        </li>
        <li>
          <a href="#contacto" class="footer-link">
            Agendá una consulta
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p class="footer-copy">
        &copy; {year} g2techwork. Hecho con ♥ en Corrientes, Argentina.
      </p>
      <div class="footer-legal">
        <a href="/privacidad" class="footer-legal-link">Privacidad</a>
        <span aria-hidden="true">·</span>
        <a href="/terminos" class="footer-legal-link">Términos</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-primary-deep, #071428);
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    padding-block: clamp(3rem, 6vw, 5rem);
    align-items: start;
  }

  /* Brand */
  .footer-brand { display: flex; flex-direction: column; gap: 1rem; }

  .footer-logo {
    font-family: var(--font-heading);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    color: #fff;
    width: fit-content;
  }
  .logo-g2   { color: var(--color-accent); }
  .logo-rest { color: #fff; }

  .footer-tagline {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.4);
    line-height: 1.7;
    max-width: 280px;
  }

  .footer-location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 500;
    color: rgba(255,255,255,0.35);
  }
  .footer-location svg { color: var(--color-accent); }

  .footer-social {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .social-link {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.5);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .social-link svg { width: 18px; height: 18px; }
  .social-link:hover {
    background: rgba(0,184,196,0.15);
    border-color: rgba(0,184,196,0.3);
    color: var(--color-accent);
  }

  /* Columns */
  .footer-col { display: flex; flex-direction: column; gap: 1rem; }

  .footer-col-title {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    color: rgba(255,255,255,0.35);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .footer-col ul { display: flex; flex-direction: column; gap: 0.5rem; }

  .footer-link {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.5);
    font-weight: 500;
    transition: color 0.15s;
    cursor: pointer;
    font-family: var(--font-heading);
  }
  .footer-link:hover { color: rgba(255,255,255,0.85); }

  /* Bottom bar */
  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.06);
    padding-block: 1.25rem;
  }
  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .footer-copy {
    font-size: 0.8125rem;
    color: rgba(255,255,255,0.25);
    font-family: var(--font-heading);
    font-weight: 500;
  }
  .footer-legal {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255,255,255,0.2);
    font-size: 0.8125rem;
  }
  .footer-legal-link {
    color: rgba(255,255,255,0.35);
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 500;
    transition: color 0.15s;
  }
  .footer-legal-link:hover { color: rgba(255,255,255,0.65); }

  @media (max-width: 1024px) {
    .footer-inner { grid-template-columns: 1fr 1fr; }
    .footer-brand { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .footer-inner { grid-template-columns: 1fr; }
    .footer-brand { grid-column: span 1; }
  }
</style>
